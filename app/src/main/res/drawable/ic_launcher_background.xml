<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-bleed dark backdrop with a soft off-center glow, so the adaptive-icon mask (circle,
         squircle, rounded-square, teardrop — varies by OEM launcher) always crops a plain,
         edge-safe field rather than any part of the mark. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="32"
                android:gradientRadius="98"
                android:startColor="#2A2A33"
                android:endColor="#131318" />
        </aapt:attr>
    </path>
</vector>

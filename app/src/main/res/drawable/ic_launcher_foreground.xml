<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vervan monogram: a chevron ("V") rendered as a single rounded stroke, plus a small
         "spark" node — the on-device AI cue. All geometry stays inside the 66dp adaptive-icon
         safe zone (a circle of radius 33 around the 54,54 center) so no OEM mask clips it.
         Colors match the app's default AMBER accent pair (see ui/theme/Theme.kt DarkAccents:
         primary #F6B24E, secondary #7C9AFF) so the launcher icon reads as the same brand as the
         in-app UI, not a separate logo. -->

    <path
        android:pathData="M36,38 L54,70 L72,38"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="36" android:startY="38"
                android:endX="72" android:endY="38"
                android:startColor="#F6B24E"
                android:endColor="#7C9AFF" />
        </aapt:attr>
    </path>

    <!-- AI spark node, floating just off the chevron's right arm. -->
    <path android:pathData="M65,64 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60.5" android:startY="59.5"
                android:endX="69.5" android:endY="68.5"
                android:startColor="#FFE1B0"
                android:endColor="#F6B24E" />
        </aapt:attr>
    </path>

    <!-- Small twinkle accent, top-right. -->
    <path
        android:pathData="M74,27 L79,32 L74,37 L69,32 Z"
        android:fillColor="#FFE1B0"
        android:fillAlpha="0.92" />

</vector>
